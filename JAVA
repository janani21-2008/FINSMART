import java.io.IOException;
import java.net.InetSocketAddress;
import java.net.URLDecoder;
import java.nio.charset.StandardCharsets;
import java.nio.file.Files;
import java.nio.file.Path;
import java.nio.file.Paths;
import java.sql.Connection;
import java.sql.DriverManager;
import java.sql.PreparedStatement;
import java.sql.ResultSet;
import java.sql.SQLException;
import java.sql.Statement;
import java.util.LinkedHashMap;
import java.util.Map;

import com.sun.net.httpserver.HttpExchange;
import com.sun.net.httpserver.HttpServer;

/**
 * FINSMART Core Java backend using the built-in Java HTTP server and SQLite JDBC.
 * Run this class from the FinSmart project root, with the Web folder beside it.
 * This server provides local APIs and serves files from the Web folder.
 */
public class FinSmartServer {
    private static final int PORT = 8080;
    private static final Path WEB_ROOT = Paths.get("Web").toAbsolutePath().normalize();
    private static final Path DATA_DIR = Paths.get("data").toAbsolutePath().normalize();
    private static final Path DB_FILE = DATA_DIR.resolve("finsmart.db");
    private static final String DB_URL = "jdbc:sqlite:" + DB_FILE;

    public static void main(String[] args) throws IOException, SQLException {
        Files.createDirectories(DATA_DIR);
        if (!Files.isDirectory(WEB_ROOT)) {
            throw new IllegalStateException("Web folder not found. Run this program from the FinSmart project root.");
        }

        initializeDatabase();

        HttpServer server = HttpServer.create(new InetSocketAddress("127.0.0.1", PORT), 0);
        server.createContext("/api/health", FinSmartServer::handleHealth);
        server.createContext("/api/incomes", FinSmartServer::handleIncomes);
        server.createContext("/api/expenses", FinSmartServer::handleExpenses);
        server.createContext("/api/goals", FinSmartServer::handleGoals);
        server.createContext("/api/budget", FinSmartServer::handleBudget);
        server.createContext("/api/summary", FinSmartServer::handleSummary);
        server.createContext("/", FinSmartServer::handleStaticFiles);
        server.setExecutor(null);
        server.start();

        System.out.println("FinSmart server is running at http://localhost:" + PORT);
        System.out.println("SQLite database: " + DB_FILE);
        System.out.println("Press Ctrl+C to stop the server.");
    }

    private static Connection connect() throws SQLException {
        return DriverManager.getConnection(DB_URL);
    }

    private static void initializeDatabase() throws SQLException {
        try (Connection conn = connect(); Statement st = conn.createStatement()) {
            st.executeUpdate("""
                CREATE TABLE IF NOT EXISTS incomes (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    source TEXT NOT NULL,
                    amount REAL NOT NULL CHECK(amount > 0),
                    category TEXT NOT NULL,
                    income_date TEXT NOT NULL,
                    created_at TEXT DEFAULT CURRENT_TIMESTAMP
                )
                """);
            st.executeUpdate("""
                CREATE TABLE IF NOT EXISTS expenses (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    expense_name TEXT NOT NULL,
                    amount REAL NOT NULL CHECK(amount > 0),
                    category TEXT NOT NULL,
                    expense_date TEXT NOT NULL,
                    created_at TEXT DEFAULT CURRENT_TIMESTAMP
                )
                """);
            st.executeUpdate("""
                CREATE TABLE IF NOT EXISTS savings_goals (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    goal_name TEXT NOT NULL UNIQUE,
                    target_amount REAL NOT NULL CHECK(target_amount > 0),
                    saved_amount REAL NOT NULL DEFAULT 0 CHECK(saved_amount >= 0),
                    CHECK(saved_amount <= target_amount)
                )
                """);
            st.executeUpdate("""
                CREATE TABLE IF NOT EXISTS budgets (
                    id INTEGER PRIMARY KEY CHECK(id = 1),
                    monthly_budget REAL NOT NULL CHECK(monthly_budget > 0)
                )
                """);
        }
    }

    private static void handleHealth(HttpExchange ex) throws IOException {
        if (!"GET".equals(ex.getRequestMethod())) {
            sendJson(ex, 405, "{\"error\":\"Method not allowed\"}");
            return;
        }
        sendJson(ex, 200, "{\"status\":\"ok\",\"application\":\"FinSmart\"}");
    }

    private static void handleIncomes(HttpExchange ex) throws IOException {
        try {
            if ("GET".equals(ex.getRequestMethod())) {
                StringBuilder json = new StringBuilder("[");
                try (Connection conn = connect();
                     Statement st = conn.createStatement();
                     ResultSet rs = st.executeQuery("SELECT id, source, amount, category, income_date FROM incomes ORDER BY id DESC")) {
                    boolean first = true;
                    while (rs.next()) {
                        if (!first) json.append(',');
                        first = false;
                        json.append("{\"id\":").append(rs.getInt("id"))
                            .append(",\"source\":").append(quote(rs.getString("source")))
                            .append(",\"amount\":").append(rs.getDouble("amount"))
                            .append(",\"category\":").append(quote(rs.getString("category")))
                            .append(",\"date\":").append(quote(rs.getString("income_date"))).append('}');
                    }
                }
                json.append(']');
                sendJson(ex, 200, json.toString());
            } else if ("POST".equals(ex.getRequestMethod())) {
                Map<String, String> form = readForm(ex);
                String source = required(form, "source");
                String category = required(form, "category");
                String date = required(form, "date");
                double amount = positiveAmount(form, "amount");
                try (Connection conn = connect(); PreparedStatement ps = conn.prepareStatement(
                        "INSERT INTO incomes(source, amount, category, income_date) VALUES(?,?,?,?)")) {
                    ps.setString(1, source);
                    ps.setDouble(2, amount);
                    ps.setString(3, category);
                    ps.setString(4, date);
                    ps.executeUpdate();
                }
                sendJson(ex, 201, "{\"message\":\"Income saved successfully\"}");
            } else {
                sendJson(ex, 405, "{\"error\":\"Method not allowed\"}");
            }
        } catch (IllegalArgumentException e) {
            sendJson(ex, 400, jsonError(e.getMessage()));
        } catch (SQLException e) {
            sendJson(ex, 500, jsonError("Database error while handling incomes"));
        }
    }

